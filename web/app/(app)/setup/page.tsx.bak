"use client";
/* eslint-disable @typescript-eslint/no-explicit-any */

import { useTranslations } from "next-intl";
import { useEffect, useState } from "react";

import { UserMenu } from "@/components/user-menu";
import { agents as agentsApi, instances as instancesApi } from "@/lib/api/agents";
import { departments as deptsApi, people as peopleApi, type DepartmentOut, type ActivityOut } from "@/lib/api/departments";
import type { Agent } from "@/lib/api/types";

import "./home-v2.css";
import "./department-setup.css";

// =============================================================================
// SetupPage — CRUD real de Departments → Squads → Activities → Headcount/Schedule
// =============================================================================
export default function SetupPage() {
  const [depts, setDepts] = useState<DepartmentOut[]>([]);
  const [agentDefs, setAgentDefs] = useState<Agent[]>([]);
  const [people, setPeople] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [selectedDeptId, setSelectedDeptId] = useState<string | null>(null);
  const [showNewDept, setShowNewDept] = useState(false);

  useEffect(() => {
    void reload();
  }, []);

  async function reload() {
    setLoading(true);
    try {
      const [d, a, p] = await Promise.all([
        deptsApi.list().catch(() => []),
        agentsApi.list().catch(() => []),
        peopleApi.list().catch(() => []),
      ]);
      setDepts(d);
      setAgentDefs(a);
      setPeople(p);
      // Se o selecionado não existe mais (foi deletado), seleciona outro
      const stillExists = selectedDeptId && d.some((x) => x.id === selectedDeptId);
      if (!stillExists) {
        setSelectedDeptId(d.length > 0 ? d[0].id : null);
      }
    } finally {
      setLoading(false);
    }
  }

  const selected = depts.find((d) => d.id === selectedDeptId);

  return (
    <div style={{ minHeight: "100vh", background: "var(--bg)" }}>
      <main style={{ padding: "32px 48px", maxWidth: 1400, margin: "0 auto" }}>
        <SetupHeader onNew={() => setShowNewDept(true)} />

        <div style={{ display: "grid", gridTemplateColumns: "260px minmax(0, 1fr)", gap: 24, marginTop: 32, alignItems: "start" }}>
          <DeptList depts={depts} selectedId={selectedDeptId} onSelect={setSelectedDeptId} loading={loading} />
          <div style={{ minWidth: 0 }}>
            {selected ? (
              <DeptEditor
                dept={selected}
                agents={agentDefs}
                people={people}
                onChange={reload}
              />
            ) : (
              <EmptyDept onNew={() => setShowNewDept(true)} />
            )}
          </div>
        </div>

        {showNewDept && (
          <NewDeptModal
            people={people}
            onClose={() => setShowNewDept(false)}
            onCreated={(id) => { setShowNewDept(false); setSelectedDeptId(id); reload(); }}
          />
        )}
      </main>
    </div>
  );
}

// =============================================================================
// SetupHeader
// =============================================================================
function SetupHeader({ onNew }: { onNew: () => void }) {
  const t = useTranslations("setup");
  return (
    <header>
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
        <div style={{ fontSize: 12, color: "var(--text-subtle)", letterSpacing: "0.06em", textTransform: "uppercase" }}>
          <a href="/dashboard" style={{ color: "inherit", textDecoration: "none" }}>← {t("breadcrumb_workforce")}</a>
          <span style={{ margin: "0 8px" }}>/</span>
          <span>{t("breadcrumb_setup")}</span>
        </div>
        <UserMenu userName="Wagner" userOrg="Arctica" userRole="admin" />
      </div>
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginTop: 12 }}>
        <div>
          <h1 style={{ fontFamily: "var(--font-display)", fontSize: 32, margin: 0, letterSpacing: "-0.02em" }}>
            {t("title")}
          </h1>
          <p style={{ color: "var(--text-muted)", marginTop: 4, fontSize: 15 }}>
            {t("sub")}
          </p>
        </div>
        <button onClick={onNew} className="btn-primary" style={{ width: "auto", padding: "10px 18px" }}>
          + {t("new_department" as any) ?? "Novo departamento"}
        </button>
      </div>
    </header>
  );
}

// =============================================================================
// DeptList — sidebar de departments
// =============================================================================
function DeptList({ depts, selectedId, onSelect, loading }: any) {
  const t = useTranslations("setup");
  const tc = useTranslations("common");
  return (
    <aside style={{
      background: "var(--bg-elev)", border: "1px solid var(--border)",
      borderRadius: "var(--radius-lg)", padding: 12, height: "fit-content",
    }}>
      <div style={{ fontSize: 11, color: "var(--text-subtle)", letterSpacing: "0.08em", textTransform: "uppercase", padding: "6px 8px", fontWeight: 600 }}>
        {t("departments")}
      </div>
      {loading && <div style={{ padding: 12, color: "var(--text-muted)", fontSize: 13 }}>{tc("loading")}</div>}
      {!loading && depts.length === 0 && (
        <div style={{ padding: 12, color: "var(--text-muted)", fontSize: 13 }}>
          {t("no_departments")}
        </div>
      )}
      {depts.map((d: DepartmentOut) => (
        <button
          key={d.id}
          onClick={() => onSelect(d.id)}
          style={{
            display: "block", width: "100%", textAlign: "left",
            padding: "10px 12px", borderRadius: 8, border: 0,
            background: d.id === selectedId ? "var(--accent-soft)" : "transparent",
            color: d.id === selectedId ? "var(--accent)" : "var(--text)",
            fontWeight: d.id === selectedId ? 600 : 500, fontSize: 14,
            cursor: "pointer", marginBottom: 2,
          }}
        >
          <div>{d.display_name}</div>
          <div style={{ fontSize: 11, color: "var(--text-subtle)", marginTop: 2 }}>
            {d.squads.length} {t("squads_count")} · {d.total_agents} {t("agents_count")}
          </div>
        </button>
      ))}
    </aside>
  );
}

function EmptyDept({ onNew }: { onNew: () => void }) {
  const t = useTranslations("setup");
  return (
    <div style={{
      width: "100%", padding: "80px 40px", textAlign: "center",
      border: "1px dashed var(--border-strong)", borderRadius: "var(--radius-lg)",
      background: "var(--bg-elev)", minHeight: 400,
      display: "flex", flexDirection: "column", justifyContent: "center", alignItems: "center",
    }}>
      <div style={{
        width: 56, height: 56, borderRadius: 14, background: "var(--accent-soft)",
        color: "var(--accent)", display: "grid", placeItems: "center", marginBottom: 18,
        fontSize: 24, fontWeight: 700,
      }}>+</div>
      <h2 style={{ fontFamily: "var(--font-display)", fontSize: 24, margin: 0, letterSpacing: "-0.02em" }}>
        {t("empty_title")}
      </h2>
      <p style={{ color: "var(--text-muted)", marginTop: 8, marginBottom: 24, maxWidth: 420, fontSize: 14 }}>
        {t("empty_sub")}
      </p>
      <button onClick={onNew} className="btn-primary" style={{ display: "inline-flex", width: "auto", padding: "10px 24px" }}>
        + {t("new_dept_title")}
      </button>
    </div>
  );
}

// =============================================================================
// DeptEditor — edita um departamento + suas squads/activities
// =============================================================================
function DeptEditor({ dept, agents, people, onChange }: { dept: DepartmentOut; agents: Agent[]; people: any[]; onChange: () => void }) {
  const t = useTranslations("setup");
  const tc = useTranslations("common");
  const owner = people.find((p: any) => p.id === dept.owner_user_id);
  const [showNewSquad, setShowNewSquad] = useState(false);
  const [confirmDelete, setConfirmDelete] = useState(false);

  async function deleteDept() {
    await deptsApi.remove(dept.id);
    onChange();
  }

  return (
    <section>
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 8 }}>
        <div>
          <h2 style={{ fontFamily: "var(--font-display)", fontSize: 26, margin: 0, letterSpacing: "-0.02em" }}>
            {dept.display_name}
          </h2>
          <div style={{ fontSize: 13, color: "var(--text-muted)", marginTop: 4, fontFamily: "var(--font-mono)" }}>
            {dept.name}
          </div>
        </div>
        <button onClick={() => setConfirmDelete(true)} style={{
          background: "transparent", border: "1px solid var(--border)", color: "var(--danger)",
          padding: "6px 12px", borderRadius: 8, cursor: "pointer", fontSize: 13,
        }}>
          {t("delete_dept_btn")}
        </button>
      </div>

      {confirmDelete && (
        <ConfirmModal
          title={t("delete_dept_title")}
          message={t("delete_dept_msg", { name: dept.display_name })}
          confirmLabel={tc("yes_delete")}
          danger
          onConfirm={() => { setConfirmDelete(false); deleteDept(); }}
          onCancel={() => setConfirmDelete(false)}
        />
      )}

      {showNewSquad && (
        <NewSquadModal
          dept={dept}
          onClose={() => setShowNewSquad(false)}
          onCreated={() => { setShowNewSquad(false); onChange(); }}
        />
      )}

      <p style={{ color: "var(--text-muted)", margin: "8px 0 20px", fontSize: 14 }}>
        {dept.objective || t("no_objective")}
      </p>

      <div style={{
        display: "grid", gridTemplateColumns: "repeat(3, 1fr)", gap: 12,
        background: "var(--bg-sunken)", padding: 16, borderRadius: "var(--radius)",
        marginBottom: 24,
      }}>
        <Stat label={t("stat_owner")} value={owner?.name ?? "—"} />
        <Stat label={t("stat_total_agents")} value={String(dept.total_agents)} />
        <Stat label={t("stat_health")} value={dept.health} />
      </div>

      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 12 }}>
        <h3 style={{ fontFamily: "var(--font-display)", fontSize: 18, margin: 0 }}>{t("squads")}</h3>
        <button onClick={() => setShowNewSquad(true)} className="btn-primary" style={{ width: "auto", padding: "8px 16px", fontSize: 13 }}>
          {t("new_squad")}
        </button>
      </div>

      {dept.squads.length === 0 ? (
        <div style={{ padding: 24, textAlign: "center", border: "1px dashed var(--border-strong)", borderRadius: "var(--radius)", color: "var(--text-muted)" }}>
          {t("no_squads")}
        </div>
      ) : (
        dept.squads.map((squad) => (
          <SquadCard key={squad.id} dept={dept} squad={squad} agents={agents} onChange={onChange} />
        ))
      )}
    </section>
  );
}

function Stat({ label, value }: any) {
  return (
    <div>
      <div style={{ fontSize: 11, color: "var(--text-subtle)", textTransform: "uppercase", letterSpacing: "0.06em" }}>{label}</div>
      <div style={{ fontSize: 16, fontWeight: 600, marginTop: 4 }}>{value}</div>
    </div>
  );
}

// =============================================================================
// SquadCard
// =============================================================================
function SquadCard({ dept, squad, agents, onChange }: any) {
  const t = useTranslations("setup");
  const tc = useTranslations("common");
  const [showNewActivity, setShowNewActivity] = useState(false);
  const [confirmDelete, setConfirmDelete] = useState(false);

  async function deleteSquad() {
    await deptsApi.removeSquad(dept.id, squad.id);
    onChange();
  }

  return (
    <div style={{
      background: "var(--bg-elev)", border: "1px solid var(--border)",
      borderRadius: "var(--radius)", padding: 16, marginBottom: 12,
    }}>
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 12 }}>
        <h4 style={{ margin: 0, fontFamily: "var(--font-display)", fontSize: 15, fontWeight: 600 }}>
          {squad.display_name}
        </h4>
        <div style={{ display: "flex", gap: 8 }}>
          <button onClick={() => setShowNewActivity(true)} style={{
            background: "transparent", border: "1px solid var(--border)",
            padding: "4px 10px", borderRadius: 6, cursor: "pointer", fontSize: 12,
          }}>
            {t("new_activity")}
          </button>
          <button onClick={() => setConfirmDelete(true)} style={{
            background: "transparent", border: 0, color: "var(--danger)",
            padding: "4px 8px", cursor: "pointer", fontSize: 12,
          }}>
            ×
          </button>
        </div>
      </div>

      {confirmDelete && (
        <ConfirmModal
          title={t("delete_squad_title")}
          message={t("delete_squad_msg", { name: squad.display_name })}
          confirmLabel={tc("yes_delete")}
          danger
          onConfirm={() => { setConfirmDelete(false); deleteSquad(); }}
          onCancel={() => setConfirmDelete(false)}
        />
      )}
      {showNewActivity && (
        <NewActivityModal
          dept={dept}
          squad={squad}
          onClose={() => setShowNewActivity(false)}
          onCreated={() => { setShowNewActivity(false); onChange(); }}
        />
      )}
      {squad.activities.length === 0 ? (
        <div style={{ color: "var(--text-muted)", fontSize: 13, padding: "8px 0" }}>
          {t("no_activities")}
        </div>
      ) : (
        <div style={{ display: "grid", gap: 8 }}>
          {squad.activities.map((a: ActivityOut) => (
            <ActivityRow
              key={a.id} dept={dept} squad={squad} activity={a}
              agents={agents} onChange={onChange}
            />
          ))}
        </div>
      )}
    </div>
  );
}

// =============================================================================
// ActivityRow — onde se ajusta agent (skill), headcount e schedule
// =============================================================================
function ActivityRow({ dept, squad, activity, agents, onChange }: any) {
  const t = useTranslations("setup");
  const tc = useTranslations("common");
  const [agentId, setAgentId] = useState<string>(activity.default_agent_id ?? "");
  const [schedule, setSchedule] = useState<string>(activity.schedule ?? "");
  const [target, setTarget] = useState<number>(activity.target_agent_count);
  const [saving, setSaving] = useState(false);

  async function save() {
    setSaving(true);
    try {
      // Atualiza activity (agent + schedule)
      await deptsApi.updateActivity(dept.id, squad.id, activity.id, {
        default_agent_id: agentId || null,
        schedule: schedule || null,
      });
      // Se mudou o headcount, escala
      if (target !== activity.target_agent_count) {
        await instancesApi.scale(activity.id, target, agentId || undefined);
      }
      onChange();
    } finally {
      setSaving(false);
    }
  }

  const [confirmDelete, setConfirmDelete] = useState(false);
  async function deleteActivity() {
    await deptsApi.removeActivity(dept.id, squad.id, activity.id);
    onChange();
  }

  const dirty =
    agentId !== (activity.default_agent_id ?? "") ||
    schedule !== (activity.schedule ?? "") ||
    target !== activity.target_agent_count;

  return (
    <div style={{
      border: "1px solid var(--border)", borderRadius: "var(--radius-sm)",
      padding: 12, background: "var(--bg)",
    }}>
      <div style={{ display: "grid", gridTemplateColumns: "60px 1fr 1fr 1fr 100px auto", gap: 12, alignItems: "center" }}>
        <span style={{
          fontFamily: "var(--font-mono)", fontSize: 11, fontWeight: 600,
          color: "var(--accent)", background: "var(--accent-soft)",
          padding: "4px 8px", borderRadius: 4, textAlign: "center",
        }}>
          {activity.skill_code || "···"}
        </span>
        <div>
          <div style={{ fontWeight: 500 }}>{activity.display_name}</div>
          <div style={{ fontSize: 11, color: "var(--text-subtle)", fontFamily: "var(--font-mono)" }}>{activity.name}</div>
        </div>
        <select
          value={agentId} onChange={(e) => setAgentId(e.target.value)}
          style={{ ...inputStyle, fontSize: 13 }}
        >
          <option value="">{tc("select_skill")}</option>
          {agents.map((a: Agent) => (
            <option key={a.id} value={a.id}>{a.display_name} ({a.name})</option>
          ))}
        </select>
        <input
          value={schedule} onChange={(e) => setSchedule(e.target.value)}
          placeholder={t("schedule_placeholder")} style={{ ...inputStyle, fontFamily: "var(--font-mono)", fontSize: 12 }}
        />
        <div style={{ display: "flex", alignItems: "center", gap: 4 }}>
          <button onClick={() => setTarget(Math.max(0, target - 1))}
            style={countBtnStyle} title={t("fire_one")}>−</button>
          <input type="number" value={target} onChange={(e) => setTarget(Math.max(0, parseInt(e.target.value) || 0))}
            style={{ ...inputStyle, width: 50, textAlign: "center", fontSize: 13 }} />
          <button onClick={() => setTarget(target + 1)}
            style={countBtnStyle} title={t("hire_one")}>+</button>
        </div>
        <div style={{ display: "flex", gap: 4 }}>
          {dirty && (
            <button onClick={save} disabled={saving}
              className="btn-primary" style={{ width: "auto", padding: "6px 12px", fontSize: 12 }}>
              {saving ? "..." : tc("save")}
            </button>
          )}
          <button onClick={() => setConfirmDelete(true)} style={{
            background: "transparent", border: 0, color: "var(--danger)", padding: "4px 8px", cursor: "pointer",
          }}>×</button>
        </div>
      </div>
      {confirmDelete && (
        <ConfirmModal
          title={t("delete_activity_title")}
          message={t("delete_activity_msg", { name: activity.display_name })}
          confirmLabel={tc("yes_delete")}
          danger
          onConfirm={() => { setConfirmDelete(false); deleteActivity(); }}
          onCancel={() => setConfirmDelete(false)}
        />
      )}
      <div style={{ display: "flex", gap: 16, marginTop: 8, fontSize: 11, color: "var(--text-muted)" }}>
        <span style={{ color: "oklch(0.55 0.18 155)" }}>● {activity.active_count} {t("active")}</span>
        <span style={{ color: "oklch(0.70 0.13 155)" }}>● {activity.idle_count} {t("idle")}</span>
        <span style={{ color: "var(--text-subtle)" }}>● {activity.offline_count} {t("offline")}</span>
        {activity.error_count > 0 && <span style={{ color: "var(--danger)" }}>● {activity.error_count} {t("error")}</span>}
        <span style={{ marginLeft: "auto" }}>{t("hired")}: <strong>{activity.agent_count}</strong> / {t("target")} {activity.target_agent_count}</span>
      </div>
    </div>
  );
}

const inputStyle: any = {
  width: "100%",
  boxSizing: "border-box",
  padding: "8px 10px",
  border: "1px solid var(--border-strong)",
  borderRadius: "var(--radius-sm)",
  background: "var(--bg-elev)",
  color: "var(--text)",
  outline: "none",
  fontSize: 13,
};
const countBtnStyle: any = {
  width: 28, height: 28, border: "1px solid var(--border-strong)",
  borderRadius: "var(--radius-sm)", background: "var(--bg-elev)", cursor: "pointer",
  fontSize: 16, fontWeight: 600, color: "var(--text)",
};

// =============================================================================
// NewDeptModal
// =============================================================================
function NewDeptModal({ people, onClose, onCreated }: any) {
  const t = useTranslations("setup");
  const tc = useTranslations("common");
  const [name, setName] = useState("");
  const [displayName, setDisplayName] = useState("");
  const [objective, setObjective] = useState("");
  const [ownerUserId, setOwnerUserId] = useState("");
  const [budget, setBudget] = useState(0);
  const [saving, setSaving] = useState(false);
  const [err, setErr] = useState<string | null>(null);

  function autoName(v: string) {
    setDisplayName(v);
    if (!name || name === slugify(displayName)) setName(slugify(v));
  }

  async function save() {
    setSaving(true);
    setErr(null);
    try {
      const created = await deptsApi.create({
        name, display_name: displayName, objective,
        owner_user_id: ownerUserId || null,
        monthly_cost_budget_usd: budget, health: "healthy",
      });
      onCreated(created.id);
    } catch (e: any) {
      setErr(e?.detail ?? "Error.");
    } finally {
      setSaving(false);
    }
  }

  return (
    <ModalShell onClose={onClose}>
      <h2 style={{ margin: 0, fontFamily: "var(--font-display)", fontSize: 20 }}>{t("new_dept_title")}</h2>
      <p style={{ color: "var(--text-muted)", margin: "4px 0 20px", fontSize: 13 }}>
        {t("new_dept_sub")}
      </p>

      <div style={{ display: "grid", gap: 12 }}>
        <Field label={tc("display_name")}>
          <input value={displayName} onChange={(e) => autoName(e.target.value)} placeholder="Finance" style={inputStyle} autoFocus />
        </Field>
        <Field label={tc("slug")}>
          <input value={name} onChange={(e) => setName(e.target.value)} placeholder="finance" style={{ ...inputStyle, fontFamily: "var(--font-mono)" }} />
        </Field>
        <Field label={tc("objective")}>
          <textarea value={objective} onChange={(e) => setObjective(e.target.value)} rows={2}
            style={{ ...inputStyle, resize: "vertical" as any }} />
        </Field>
        <Field label={tc("owner")}>
          <select value={ownerUserId} onChange={(e) => setOwnerUserId(e.target.value)} style={inputStyle}>
            <option value="">{tc("no_owner")}</option>
            {people.map((p: any) => <option key={p.id} value={p.id}>{p.name} · {p.role}</option>)}
          </select>
        </Field>
        <Field label={t("monthly_budget")}>
          <input type="number" value={budget} onChange={(e) => setBudget(parseFloat(e.target.value) || 0)} style={inputStyle} />
        </Field>
      </div>

      {err && <div style={{ color: "var(--danger)", fontSize: 13, marginTop: 12 }}>{err}</div>}

      <div style={{ display: "flex", gap: 8, justifyContent: "flex-end", marginTop: 20 }}>
        <button onClick={onClose} style={modalGhostBtn}>{tc("cancel")}</button>
        <button onClick={save} disabled={saving || !name || !displayName} style={modalPrimaryBtn}>
          {saving ? tc("creating") : t("create_dept")}
        </button>
      </div>
    </ModalShell>
  );
}

function Field({ label, children }: any) {
  return (
    <div>
      <label style={{ fontSize: 12, color: "var(--text-muted)", display: "block", marginBottom: 4, fontWeight: 500 }}>
        {label}
      </label>
      {children}
    </div>
  );
}

function slugify(v: string) {
  return v.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
}

// =============================================================================
// ConfirmModal — substitui window.confirm
// =============================================================================
function ConfirmModal({ title, message, confirmLabel, danger = false, onConfirm, onCancel }: any) {
  const tc = useTranslations("common");
  return (
    <ModalShell onClose={onCancel}>
      <h2 style={{ margin: 0, fontFamily: "var(--font-display)", fontSize: 18 }}>{title}</h2>
      <p style={{ color: "var(--text-muted)", margin: "8px 0 20px", fontSize: 14 }}>{message}</p>
      <div style={{ display: "flex", gap: 8, justifyContent: "flex-end" }}>
        <button onClick={onCancel} style={modalGhostBtn}>{tc("cancel")}</button>
        <button onClick={onConfirm} style={danger ? modalDangerBtn : modalPrimaryBtn}>
          {confirmLabel ?? tc("confirm")}
        </button>
      </div>
    </ModalShell>
  );
}

// =============================================================================
// NewSquadModal
// =============================================================================
function NewSquadModal({ dept, onClose, onCreated }: any) {
  const t = useTranslations("setup");
  const tc = useTranslations("common");
  const [name, setName] = useState("");
  const [displayName, setDisplayName] = useState("");
  const [saving, setSaving] = useState(false);
  const [err, setErr] = useState<string | null>(null);

  function autoName(v: string) {
    setDisplayName(v);
    if (!name || name === slugify(displayName)) setName(slugify(v));
  }

  async function save() {
    setSaving(true); setErr(null);
    try {
      await deptsApi.createSquad(dept.id, { name, display_name: displayName, position: dept.squads.length });
      onCreated();
    } catch (e: any) {
      setErr(e?.detail ?? "Error.");
    } finally {
      setSaving(false);
    }
  }

  return (
    <ModalShell onClose={onClose}>
      <h2 style={{ margin: 0, fontFamily: "var(--font-display)", fontSize: 18 }}>{t("new_squad_title")}</h2>
      <p style={{ color: "var(--text-muted)", margin: "4px 0 16px", fontSize: 13 }}>
        {t("new_squad_sub", { dept: dept.display_name })}
      </p>
      <div style={{ display: "grid", gap: 12 }}>
        <Field label={tc("display_name")}>
          <input value={displayName} onChange={(e) => autoName(e.target.value)}
            placeholder="Accounts Payable" style={inputStyle} autoFocus />
        </Field>
        <Field label={tc("slug")}>
          <input value={name} onChange={(e) => setName(e.target.value)}
            style={{ ...inputStyle, fontFamily: "var(--font-mono)" }} />
        </Field>
      </div>
      {err && <div style={{ color: "var(--danger)", fontSize: 13, marginTop: 12 }}>{err}</div>}
      <div style={{ display: "flex", gap: 8, justifyContent: "flex-end", marginTop: 20 }}>
        <button onClick={onClose} style={modalGhostBtn}>{tc("cancel")}</button>
        <button onClick={save} disabled={saving || !name || !displayName} style={modalPrimaryBtn}>
          {saving ? tc("creating") : t("create_squad")}
        </button>
      </div>
    </ModalShell>
  );
}

// =============================================================================
// NewActivityModal
// =============================================================================
function NewActivityModal({ dept, squad, onClose, onCreated }: any) {
  const t = useTranslations("setup");
  const tc = useTranslations("common");
  const [name, setName] = useState("");
  const [displayName, setDisplayName] = useState("");
  const [skillCode, setSkillCode] = useState("");
  const [saving, setSaving] = useState(false);
  const [err, setErr] = useState<string | null>(null);

  function autoName(v: string) {
    setDisplayName(v);
    if (!name || name === slugify(displayName)) setName(slugify(v));
    if (!skillCode || skillCode.length <= 3) {
      const guess = v.split(/\s+/).map((w: string) => w[0] || "").join("").slice(0, 3).toUpperCase();
      setSkillCode(guess);
    }
  }

  async function save() {
    setSaving(true); setErr(null);
    try {
      await deptsApi.createActivity(dept.id, squad.id, {
        name, display_name: displayName, skill_code: skillCode,
        target_agent_count: 0, position: squad.activities.length,
      });
      onCreated();
    } catch (e: any) {
      setErr(e?.detail ?? "Error.");
    } finally {
      setSaving(false);
    }
  }

  return (
    <ModalShell onClose={onClose}>
      <h2 style={{ margin: 0, fontFamily: "var(--font-display)", fontSize: 18 }}>{t("new_activity_title")}</h2>
      <p style={{ color: "var(--text-muted)", margin: "4px 0 16px", fontSize: 13 }}>
        {t("new_activity_sub", { squad: squad.display_name })}
      </p>
      <div style={{ display: "grid", gap: 12 }}>
        <Field label={tc("display_name")}>
          <input value={displayName} onChange={(e) => autoName(e.target.value)}
            placeholder="Invoice validator" style={inputStyle} autoFocus />
        </Field>
        <div style={{ display: "grid", gridTemplateColumns: "1fr 100px", gap: 12 }}>
          <Field label={tc("slug")}>
            <input value={name} onChange={(e) => setName(e.target.value)}
              style={{ ...inputStyle, fontFamily: "var(--font-mono)" }} />
          </Field>
          <Field label={t("skill_code")}>
            <input value={skillCode} onChange={(e) => setSkillCode(e.target.value.toUpperCase().slice(0, 3))}
              style={{ ...inputStyle, fontFamily: "var(--font-mono)", textAlign: "center" }} maxLength={3} />
          </Field>
        </div>
      </div>
      {err && <div style={{ color: "var(--danger)", fontSize: 13, marginTop: 12 }}>{err}</div>}
      <div style={{ display: "flex", gap: 8, justifyContent: "flex-end", marginTop: 20 }}>
        <button onClick={onClose} style={modalGhostBtn}>{tc("cancel")}</button>
        <button onClick={save} disabled={saving || !name || !displayName} style={modalPrimaryBtn}>
          {saving ? tc("creating") : t("create_activity")}
        </button>
      </div>
    </ModalShell>
  );
}

// =============================================================================
// ModalShell + estilos compartilhados
// =============================================================================
function ModalShell({ children, onClose }: any) {
  return (
    <div onClick={onClose} style={{
      position: "fixed", inset: 0, background: "rgba(0,0,0,0.4)",
      display: "grid", placeItems: "center", padding: 20, zIndex: 100,
    }}>
      <div onClick={(e) => e.stopPropagation()} style={{
        background: "var(--bg-elev)", borderRadius: "var(--radius-lg)",
        padding: 24, width: "100%", maxWidth: 460,
      }}>
        {children}
      </div>
    </div>
  );
}

const modalPrimaryBtn: any = {
  padding: "8px 18px", border: 0, borderRadius: 8,
  background: "var(--accent)", color: "white", cursor: "pointer", fontSize: 13, fontWeight: 600,
};
const modalGhostBtn: any = {
  padding: "8px 18px", border: "1px solid var(--border)", borderRadius: 8,
  background: "transparent", cursor: "pointer", fontSize: 13, color: "var(--text)",
};
const modalDangerBtn: any = {
  padding: "8px 18px", border: 0, borderRadius: 8,
  background: "var(--danger)", color: "white", cursor: "pointer", fontSize: 13, fontWeight: 600,
};

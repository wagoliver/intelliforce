{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (Arctica)",
      "options": {
        "baseURL": "{env:LMSTUDIO_BASE_URL}",
        "apiKey": "{env:LMSTUDIO_API_KEY}"
      },
      "models": {
        "{env:LMSTUDIO_DEFAULT_MODEL}": {
          "name": "Arctica (default via .env)",
          "options": {
            "max_tokens": {env:LMSTUDIO_MAX_TOKENS},
            "context_length": {env:LMSTUDIO_CONTEXT_LENGTH}
          }
        }
      }
    }
  },
  "model": "lmstudio/{env:LMSTUDIO_DEFAULT_MODEL}",
  "disabled_providers": []
}

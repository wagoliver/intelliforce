# =============================================================================
# IntelliForce Worker — Python + Bun + OpenCode CLI
# =============================================================================
# Imagem que combina:
#   - Python 3.12 (worker, API, scheduler)
#   - Bun runtime (necessário pro OpenCode)
#   - OpenCode CLI globalmente instalado
# =============================================================================

FROM python:3.12-slim AS base

# -----------------------------------------------------------------------------
# Dependências do sistema
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    git \
    unzip \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# Instala OpenCode CLI via instalador oficial (binário standalone)
# Vem com Bun embarcado, não precisa de Node nem Bun separado
# Cria symlink em /usr/local/bin pra garantir que esteja no PATH default
# -----------------------------------------------------------------------------
RUN curl -fsSL https://opencode.ai/install | bash && \
    OPENCODE_BIN=$(find /root /usr/local /opt -name opencode -type f -executable 2>/dev/null | head -1) && \
    if [ -z "$OPENCODE_BIN" ]; then \
        echo "ERRO: opencode binário não encontrado após install" && exit 1; \
    fi && \
    echo "OpenCode instalado em: $OPENCODE_BIN" && \
    ln -sf "$OPENCODE_BIN" /usr/local/bin/opencode && \
    /usr/local/bin/opencode --version

# -----------------------------------------------------------------------------
# Python: dependências da aplicação
# -----------------------------------------------------------------------------
WORKDIR /app

# Copia requirements primeiro pra aproveitar cache de layer
COPY worker/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Copia código da aplicação
COPY worker/ /app/

# /workspace/opencode é a fonte (volume read-only). /opencode-runtime é onde o
# entrypoint copia + substitui placeholders {env:VAR} antes de o app rodar.
WORKDIR /workspace
ENV OPENCODE_CONFIG_PATH=/opencode-runtime \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1

# -----------------------------------------------------------------------------
# System seeds — arquivos imutáveis que devem sempre existir e sempre estar
# na versão canônica (git). Bakeados na imagem; o entrypoint copia pra dentro
# do mount writable em todo startup, sobrescrevendo modificações.
#
# Pra "atualizar" um seed: edite o arquivo no repo e rebuild a imagem.
# -----------------------------------------------------------------------------
COPY opencode/.opencode/agents/builder.md /opencode-seed/agents/builder.md
COPY opencode/.opencode/agents/operator.md /opencode-seed/agents/operator.md
COPY opencode/.opencode/skills/karpathy-guidelines/SKILL.md /opencode-seed/skills/karpathy-guidelines/SKILL.md
COPY opencode/.opencode/skills/intelliforce-api /opencode-seed/skills/intelliforce-api

# -----------------------------------------------------------------------------
# Healthcheck e entrypoint
# -----------------------------------------------------------------------------
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import sys; sys.exit(0)" || exit 1

# Entrypoint roda migrations antes de subir o serviço
COPY infrastructure/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["python", "-m", "intelliforce.worker"]

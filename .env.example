# =============================================================================
# IntelliForce — Configurações de ambiente
# =============================================================================
# Copie este arquivo pra .env e ajuste os valores antes de subir.
# Pra setup inicial: ./scripts/bootstrap.sh
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
APP_ENV=development                    # development | staging | production
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR

# -----------------------------------------------------------------------------
# Vault (cofre de secrets)
# -----------------------------------------------------------------------------
# Master key Fernet — encripta os secrets guardados no DB. Geração:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANTE: se trocar essa key, TODOS os secrets atuais ficam irrecuperáveis.
# Mantenha esta key em local seguro (futuramente: KMS/Docker secret).
VAULT_MASTER_KEY=

# -----------------------------------------------------------------------------
# PostgreSQL — estado transacional
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=intelliforce
POSTGRES_USER=intelliforce
POSTGRES_PASSWORD=change-me-in-production

# URL completa derivada dos valores acima (não precisa editar normalmente)
DATABASE_URL=postgresql+asyncpg://intelliforce:change-me-in-production@postgres:5432/intelliforce

# -----------------------------------------------------------------------------
# ClickHouse — eventos verbosos e analytics
# -----------------------------------------------------------------------------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=intelliforce_audit
CLICKHOUSE_USER=intelliforce
CLICKHOUSE_PASSWORD=change-me-in-production

# -----------------------------------------------------------------------------
# Redis — fila, cache, event bus (Streams)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# LM Studio — provedor de LLM
# -----------------------------------------------------------------------------
# host.docker.internal aponta pro Mac/Windows host onde o LM Studio roda.
# Em Linux, troque por IP da rede ou use --add-host no compose.
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
# Token gerado no LM Studio (Server -> Settings -> Generate API Key). Deixe vazio se desabilitar auth.
LMSTUDIO_API_KEY=
LMSTUDIO_DEFAULT_MODEL=qwen/qwen3.6-27b
LMSTUDIO_MAX_TOKENS=8192
LMSTUDIO_CONTEXT_LENGTH=32768

# -----------------------------------------------------------------------------
# OpenCode — runtime de agentes
# -----------------------------------------------------------------------------
# IMPORTANTE: aponta pro RUNTIME, não pra /workspace/opencode (read-only).
# O entrypoint copia /workspace/opencode -> /opencode-runtime e substitui {env:VAR}.
OPENCODE_CONFIG_PATH=/opencode-runtime
OPENCODE_TIMEOUT_SECONDS=300

# -----------------------------------------------------------------------------
# Auth — JWT
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-with-bootstrap-script-it-generates-random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Admin inicial — primeiro usuário criado automaticamente vira admin
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@arctica.com.br
ADMIN_PASSWORD=                       # se vazio, é gerado pelo bootstrap

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# Worker
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY=3                  # quantas tarefas em paralelo por worker
WORKER_POLL_INTERVAL_SECONDS=1

# Token JWT longo (TTL 365 dias) da service account `worker-internal@intelliforce.local`.
# Usado pelo TaskExecutor pra autenticar chamadas que skills agendadas (cron) fazem
# contra a própria API IntelliForce (Vault, departments, agents, etc.). Sem isso,
# qualquer skill que tente usar Vault em scheduled task falha com TOKEN_EMPTY.
#
# Como gerar:
#   docker compose exec worker python -m intelliforce.scripts.gen_worker_token
#
# Imprime o JWT em stdout — copie aqui e reinicie o worker.
WORKER_TOKEN=

# URL interna que o worker usa pra falar com a API quando dispara scheduled tasks.
# Default funciona em docker-compose (DNS interno do bridge network).
INTELLIFORCE_INTERNAL_API_URL=http://api:8000
